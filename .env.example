# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get from: https://neon.tech → Project → Connection Details
# "Pooled connection" URL (uses PgBouncer — required for Vercel serverless)
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.neon.tech/neondb?sslmode=require"

# "Direct connection" URL (bypasses pooling — required for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ─── NextAuth / Auth.js ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Your production domain (no trailing slash). Use http://localhost:3000 for dev.
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must include: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── Market Data ─────────────────────────────────────────────────────────────
# Finnhub free key (60 calls/min) — used for stocks + forex.
# Optional: without it, /markets renders crypto only and stock/forex sections
# degrade to "Data unavailable" cards. Get one at https://finnhub.io/.
# FINNHUB_API_KEY="your-finnhub-key"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Foothold"
