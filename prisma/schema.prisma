// Foothold — Prisma schema
// Database: Neon (PostgreSQL serverless)
// Auth adapter: @auth/prisma-adapter (NextAuth v5)
//
// IMPORTANT — Two URLs required for Vercel + Neon:
//   DATABASE_URL  = pooled connection (PgBouncer) — used at runtime
//   DIRECT_URL    = direct connection — used for `prisma migrate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth / @auth/prisma-adapter required tables) ──────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // RBAC — "user" | "admin". Sourced from DB into JWT; never trusted from client.
  role String @default("user")

  // Onboarding — set to true after the user completes the onboarding flow.
  onboardingCompleted Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (NextAuth)
  accounts Account[]
  sessions Session[]

  // Relations (Learning)
  lessonProgress  UserLessonProgress[]
  onboardingPrefs UserOnboardingPreferences?

  // Relations (Paper trading)
  paperPortfolio PaperPortfolio?
}

// ─── Learning ────────────────────────────────────────────────────────────────

model UserLessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonSlug  String
  chapterSlug String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug, chapterSlug])
  @@index([userId])
  @@index([userId, completedAt])
}

model UserOnboardingPreferences {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  markets                   String[]
  experience                String
  dailyGoalMins             Int      @default(10)
  readingLevel              String   @default("plain")
  goals                     String[]
  accessibilityBigText      Boolean  @default(false)
  accessibilityHighContrast Boolean  @default(false)
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Paper trading ───────────────────────────────────────────────────────────

enum PaperTradeSide {
  buy
  sell
}

model PaperPortfolio {
  id           String   @id @default(cuid())
  userId       String   @unique
  // Initial deposit — kept so all-time return % survives partial sells.
  startingCash Decimal  @db.Decimal(18, 2)
  cashBalance  Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions PaperPosition[]
  trades    PaperTrade[]
}

model PaperPosition {
  id          String  @id @default(cuid())
  portfolioId String
  symbol      String
  quantity    Decimal @db.Decimal(36, 18)
  avgCost     Decimal @db.Decimal(18, 8)
  // Accumulates on sells. Row is retained at quantity 0 so realised P&L
  // history survives a fully-closed position (Step 6/7 analytics).
  realizedPnl Decimal @default(0) @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt

  portfolio PaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@index([portfolioId])
}

model PaperTrade {
  id          String         @id @default(cuid())
  portfolioId String
  symbol      String
  side        PaperTradeSide
  quantity    Decimal        @db.Decimal(36, 18)
  price       Decimal        @db.Decimal(18, 8)
  fee         Decimal        @db.Decimal(18, 2)
  total       Decimal        @db.Decimal(18, 2)
  // Executed-price source for auditability (e.g. 'coingecko' | 'finnhub').
  provider    String?
  createdAt   DateTime       @default(now())

  portfolio PaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
}
